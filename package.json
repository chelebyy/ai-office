{
  "name": "cheleby-home",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "tsx src/observer/main.ts --dev",
    "build": "npm run typecheck && vite build",
    "start": "tsx src/observer/main.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test vite.config.ts",
    "test": "node --import tsx --test test/parser.test.ts test/reader.test.ts test/server.test.ts test/office-state.test.ts test/frame-scheduler.test.ts test/fixed-office-state.test.ts test/agent-identity.test.ts",
    "check": "npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
